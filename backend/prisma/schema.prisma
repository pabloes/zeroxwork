datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
}

model User {
  id               Int          @id @default(autoincrement())
  email            String       @unique
  password         String
  role             Role         @default(USER)
  createdAt        DateTime     @default(now())
  verified         Boolean      @default(false)
  verificationCode String?
  updatedAt        DateTime     @updatedAt
  maxQuota         Int          @default(5242880)
  extraQuota       Int          @default(0)
  displayName      String?      // Optional public name shown instead of the email
  avatarUrl        String?      // Optional avatar, always a path served by our own image service
  handle           String?      @unique // Optional public handle; the address of /member/<handle>
  fileUploads      FileUpload[]
  apiKeys          ApiKey[]
  wallets          Wallet[]
  articles         Article[]
  credits          ArticleCredit[]
  projects         Project[]          @relation("ProjectCreator")
  projectRoles     ProjectMember[]
  socials          UserSocial[]
  discordLink      DiscordLink?
  discordRoles     DiscordRoleGrant[]
  defaultNameId    Int?         @unique // Mark this as unique for one-to-one relation
  defaultName      WalletNames? @relation(fields: [defaultNameId], references: [id]) // Updated relation to renamed model

  @@map("users")
}

/// Optional social profiles a user links to their account.
/// `network` is a plain string validated against SOCIAL_NETWORKS in code, so
/// adding a network later needs no migration.
model UserSocial {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  network   String
  handle    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, network])
  @@index([userId])
  @@map("user_socials")
}

/// Verified link between a ZEROxWORK account and a Discord account, created
/// through OAuth2. Unique on both sides: a Discord account cannot be claimed by
/// two users, and a user keeps a single Discord identity.
/// No Discord token is stored here; the bot acts with its own credentials.
model DiscordLink {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  discordId    String    @unique
  username     String
  globalName   String?
  avatar       String?
  linkedAt     DateTime  @default(now())
  lastSyncedAt DateTime?
  updatedAt    DateTime  @updatedAt

  @@map("discord_links")
}

/// Extra Discord roles handed to a user from the admin panel. The bot grants
/// the base role to anyone linked; these are the ones someone decides by hand,
/// such as CRASH CITY participants and creators.
/// `roleKey` is a plain string validated in code against DISCORD_ROLE_KEYS, so
/// adding a role later needs no migration (same approach as UserSocial).
model DiscordRoleGrant {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleKey   String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleKey])
  @@index([userId])
  @@map("discord_role_grants")
}

model Wallet {
  id          Int           @id @default(autoincrement())
  address     String        @unique
  userId      Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  walletNames WalletNames[] // Updated relation to renamed model
}

model WalletNames {
  // Renamed model
  id        Int      @id @default(autoincrement())
  walletId  Int
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  name      String
  subdomain String? // New optional subdomain field
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation

  @@map("WalletDecentralandNames") // Map to the existing table
}

model FileUpload {
  id         Int      @id @default(autoincrement())
  fileName   String
  fileSize   Int
  md5Hash    String?
  sha256Hash String   @unique
  uploadDate DateTime @default(now())
  userId     Int
  analysisId String?
  status     String   @default("pending")
  dangerous  Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  banned     Boolean  @default(false)

  @@index([userId])
  @@index([sha256Hash])
  @@map("file_uploads")
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  key        String    @unique
  userId     Int
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model Article {
  id           Int                  @id @default(autoincrement())
  title        String
  content      String
  script       String?              // DEPRECATED: kept for backfill migration, will be dropped after migration
  embedUrl     String?
  embedHeight  Int?                 @default(600)
  type         String               @default("post")
  redirectUrl  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  userId       Int
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  thumbnail    String?
  /// Project gallery. `screenshots` holds image paths served by our own image
  /// service, in display order; `videoUrl` is an external embed (YouTube or
  /// Vimeo), validated in code so the allowed hosts can change without a
  /// migration. Both are empty for posts: only `project` articles require them.
  screenshots  String[]
  videoUrl     String?
  published    Boolean              @default(false)
  featured     Boolean              @default(false)
  categoryId   Int?
  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags         Tag[]
  slug         String               @unique
  lang         String               @default("es")
  sourceHash   String?
  translations ArticleTranslation[]
  slugHistory  ArticleSlug[]
  credits      ArticleCredit[]

  @@index([userId])
  @@index([categoryId])
  @@index([slug])
  @@map("articles")
}

/// Someone credited on an article. Used by the portfolio: a project has one
/// author (the account that published it) but is usually the work of several
/// people.
///
/// `name` is always stored, so collaborators without a ZEROxWORK account can be
/// credited too. `userId` links the credit to an account when there is one, and
/// that link is what turns the name into a link to /member/<handle>.
model ArticleCredit {
  id        Int      @id @default(autoincrement())
  articleId Int
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  role      String?  // free text: "code", "art", "3D"... shown next to the name
  position  Int      @default(0) // display order inside the article
  createdAt DateTime @default(now())

  @@unique([articleId, name])
  @@index([articleId])
  @@index([userId])
  @@map("article_credits")
}

model ArticleTranslation {
  id          Int      @id @default(autoincrement())
  articleId   Int
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  targetLang  String
  slug        String   @unique
  title       String
  content     String
  sourceHash  String?
  provider    String?
  cachedAt    DateTime @default(now())
  redirectUrl String?

  @@unique([articleId, targetLang])
  @@index([slug])
  @@index([articleId])
  @@map("article_translations")
}

model ArticleSlug {
  id        Int      @id @default(autoincrement())
  articleId Int
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  lang      String
  slug      String   @unique
  createdAt DateTime @default(now())

  @@index([articleId])
  @@index([lang])
  @@index([createdAt])
  @@map("article_slugs")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]

  @@map("categories")
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]
  projects  Project[]

  @@map("tags")
}

/// A portfolio item, which is not an article wearing a category.
///
/// The difference that forces its own table is authorship: an article has one
/// author and `Article.userId` is NOT NULL, while a project has no author at
/// all -- it has members, and it needs at least one. That minimum cannot be a
/// database constraint (Postgres will not require a row to have children), so
/// it is enforced in code when creating and when publishing.
///
/// Address: /portfolio/<slug>, with /portfolio/<id> always working, the same
/// rule as a member page. There is deliberately no slug history: these URLs are
/// days old, the id is a permanent fallback, and carrying a redirect table for
/// three rows is not worth it. One slug per project, not one per language --
/// the title is never translated, so five addresses for the same name is what
/// produced "golfcraft-4" in the first place. The reader's language picks the
/// translation, as it already does everywhere else.
model Project {
  id           Int                  @id @default(autoincrement())
  slug         String               @unique
  title        String
  /// One line for the card. Today the card has to cut one out of the body.
  summary      String?
  content      String
  lang         String               @default("en")
  sourceHash   String?

  /// A project always shows itself, so the cover is required here and not only
  /// in code. `screenshots` is in display order.
  thumbnail    String
  screenshots  String[]
  /// External embed (YouTube or Vimeo) and where to see the thing itself.
  /// `repoUrl` is a GitHub or GitLab repository. All three are validated in
  /// code so the allowed hosts can change without a migration.
  videoUrl     String?
  siteUrl      String?
  repoUrl      String?

  /// A portfolio reads in order, and "when" is part of what a project says.
  startedAt    DateTime?
  endedAt      DateTime?
  /// Free text validated in code: live, archived, wip.
  status       String?

  /// Nothing is published by its author's hand but their own: a project is a
  /// draft until whoever created it says otherwise, exactly like an article.
  published    Boolean              @default(false)
  featured     Boolean              @default(false)

  /// Who made the entry, which is not the same as who made the project: that
  /// is `members`. Kept so writing stays with them, and nullable so deleting
  /// an account never takes a project down with it.
  createdById  Int?
  createdBy    User?                @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)

  tags         Tag[]
  members      ProjectMember[]
  translations ProjectTranslation[]

  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([slug])
  @@index([published])
  @@index([createdById])
  @@map("projects")
}

/// Somebody who worked on a project. `userId` is the link to their account and
/// the only thing that makes the name a link to /member/<...>; `name` is what
/// to show, and stands alone for people who have no account yet.
model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  /// Free text: "code", "art", "3D"... shown next to the name.
  role      String?
  /// Display order inside the project.
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([projectId, name])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

/// A project in one other language. No slug of its own, unlike an article
/// translation: a project has a single address and the reader's language picks
/// which of these rows fills it. The title is carried even though it is never
/// translated, so the shape matches and changing that rule later costs nothing.
model ProjectTranslation {
  id         Int      @id @default(autoincrement())
  projectId  Int
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targetLang String
  title      String
  summary    String?
  content    String
  sourceHash String?
  provider   String?
  cachedAt   DateTime @default(now())

  @@unique([projectId, targetLang])
  @@index([projectId])
  @@map("project_translations")
}
