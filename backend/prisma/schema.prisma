datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
}

model User {
  id               Int          @id @default(autoincrement())
  email            String       @unique
  password         String
  role             Role         @default(USER)
  createdAt        DateTime     @default(now())
  verified         Boolean      @default(false)
  verificationCode String?
  updatedAt        DateTime     @updatedAt
  maxQuota         Int          @default(5242880)
  extraQuota       Int          @default(0)
  fileUploads      FileUpload[]
  apiKeys          ApiKey[]
  wallets          Wallet[]
  articles         Article[]
  socials          UserSocial[]
  discordLink      DiscordLink?
  discordRoles     DiscordRoleGrant[]
  defaultNameId    Int?         @unique // Mark this as unique for one-to-one relation
  defaultName      WalletNames? @relation(fields: [defaultNameId], references: [id]) // Updated relation to renamed model

  @@map("users")
}

/// Optional social profiles a user links to their account.
/// `network` is a plain string validated against SOCIAL_NETWORKS in code, so
/// adding a network later needs no migration.
model UserSocial {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  network   String
  handle    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, network])
  @@index([userId])
  @@map("user_socials")
}

/// Verified link between a ZEROxWORK account and a Discord account, created
/// through OAuth2. Unique on both sides: a Discord account cannot be claimed by
/// two users, and a user keeps a single Discord identity.
/// No Discord token is stored here; the bot acts with its own credentials.
model DiscordLink {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  discordId    String    @unique
  username     String
  globalName   String?
  avatar       String?
  linkedAt     DateTime  @default(now())
  lastSyncedAt DateTime?
  updatedAt    DateTime  @updatedAt

  @@map("discord_links")
}

/// Extra Discord roles handed to a user from the admin panel. The bot grants
/// the base role to anyone linked; these are the ones someone decides by hand,
/// such as CRASH CITY participants and creators.
/// `roleKey` is a plain string validated in code against DISCORD_ROLE_KEYS, so
/// adding a role later needs no migration (same approach as UserSocial).
model DiscordRoleGrant {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleKey   String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleKey])
  @@index([userId])
  @@map("discord_role_grants")
}

model Wallet {
  id          Int           @id @default(autoincrement())
  address     String        @unique
  userId      Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  walletNames WalletNames[] // Updated relation to renamed model
}

model WalletNames {
  // Renamed model
  id        Int      @id @default(autoincrement())
  walletId  Int
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  name      String
  subdomain String? // New optional subdomain field
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation

  @@map("WalletDecentralandNames") // Map to the existing table
}

model FileUpload {
  id         Int      @id @default(autoincrement())
  fileName   String
  fileSize   Int
  md5Hash    String?
  sha256Hash String   @unique
  uploadDate DateTime @default(now())
  userId     Int
  analysisId String?
  status     String   @default("pending")
  dangerous  Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  banned     Boolean  @default(false)

  @@index([userId])
  @@index([sha256Hash])
  @@map("file_uploads")
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  key        String    @unique
  userId     Int
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model Article {
  id           Int                  @id @default(autoincrement())
  title        String
  content      String
  script       String?              // DEPRECATED: kept for backfill migration, will be dropped after migration
  embedUrl     String?
  embedHeight  Int?                 @default(600)
  type         String               @default("post")
  redirectUrl  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  userId       Int
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  thumbnail    String?
  published    Boolean              @default(false)
  featured     Boolean              @default(false)
  categoryId   Int?
  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags         Tag[]
  slug         String               @unique
  lang         String               @default("es")
  sourceHash   String?
  translations ArticleTranslation[]
  slugHistory  ArticleSlug[]

  @@index([userId])
  @@index([categoryId])
  @@index([slug])
  @@map("articles")
}

model ArticleTranslation {
  id          Int      @id @default(autoincrement())
  articleId   Int
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  targetLang  String
  slug        String   @unique
  title       String
  content     String
  sourceHash  String?
  provider    String?
  cachedAt    DateTime @default(now())
  redirectUrl String?

  @@unique([articleId, targetLang])
  @@index([slug])
  @@index([articleId])
  @@map("article_translations")
}

model ArticleSlug {
  id        Int      @id @default(autoincrement())
  articleId Int
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  lang      String
  slug      String   @unique
  createdAt DateTime @default(now())

  @@index([articleId])
  @@index([lang])
  @@index([createdAt])
  @@map("article_slugs")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]

  @@map("categories")
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]

  @@map("tags")
}
